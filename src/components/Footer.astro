---
import site from '../data/site.json';
import { getApps } from '../lib/content';

const year = new Date().getFullYear();

// Matches the conditional route in src/pages/marketplace/[...path].astro.
const hasApps = (await getApps()).length > 0;

const socialLinks = Object.entries(site.social).filter(([, url]) => Boolean(url)) as [
  string,
  string,
][];

const labels: Record<string, string> = {
  linkedin: 'LinkedIn',
  facebook: 'Facebook',
  instagram: 'Instagram',
  pinterest: 'Pinterest',
  github: 'GitHub',
  x: 'X',
  youtube: 'YouTube',
};
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <img src="/logo-horizontal-white.png" alt={site.name} width="180" height="50" loading="lazy" />
      {site.tagline && <p class="site-footer__tagline">{site.tagline}</p>}
    </div>

    <nav aria-label="Footer">
      <h2 class="eyebrow">Company</h2>
      <ul class="site-footer__list">
        <li><a href="/">Home</a></li>
        <li><a href="/#find-your-solution">Find your solution</a></li>
        {hasApps && <li><a href="/marketplace">Marketplace</a></li>}
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow">Get in touch</h2>
      <ul class="site-footer__list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.phone && (
          <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></li>
        )}
        {site.address.city && (
          <li>{[site.address.city, site.address.region].filter(Boolean).join(', ')}</li>
        )}
      </ul>
    </div>

    {
      socialLinks.length > 0 && (
        <div>
          <h2 class="eyebrow">Follow</h2>
          <ul class="site-footer__list">
            {socialLinks.map(([key, url]) => (
              <li>
                <a href={url} rel="me noopener noreferrer" target="_blank">
                  {labels[key] ?? key}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="container site-footer__legal">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    background: var(--brand-navy);
    color: #ffffff;
    padding-block: var(--space-2xl) var(--space-md);
  }

  @media (prefers-color-scheme: dark) {
    .site-footer {
      background: #04203f;
    }
  }

  .site-footer a {
    color: #cfe0f7;
  }

  .site-footer a:hover {
    color: #ffffff;
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
  }

  .site-footer__tagline {
    margin-block-start: var(--space-sm);
    color: #b4c4da;
    max-width: 32ch;
  }

  .site-footer .eyebrow {
    color: #94a8c4;
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-xs);
    display: grid;
    gap: var(--space-2xs);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-size: var(--step--1);
    color: #b4c4da;
  }
</style>
