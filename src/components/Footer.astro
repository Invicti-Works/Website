---
import site from '../data/site.json';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();

const socialLinks = Object.entries(site.social).filter(([, url]) => Boolean(url)) as [
  string,
  string,
][];

const labels: Record<string, string> = {
  linkedin: 'LinkedIn',
  facebook: 'Facebook',
  instagram: 'Instagram',
  pinterest: 'Pinterest',
  github: 'GitHub',
  x: 'X',
  youtube: 'YouTube',
};
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <img src="/logo-horizontal-white.png" alt={site.name} width="180" height="50" loading="lazy" />
      {site.tagline && <p class="site-footer__tagline">{site.tagline}</p>}
    </div>

    <div class="site-footer__touch">
      <h2 class="eyebrow">Get in touch</h2>
      <ul class="site-footer__list">
        <li><a href="/build">Tell us what to build</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.phone && (
          <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></li>
        )}
        {site.address.city && (
          <li>{[site.address.city, site.address.region].filter(Boolean).join(', ')}</li>
        )}
      </ul>
    </div>

    {
      socialLinks.length > 0 && (
        <div>
          <h2 class="eyebrow">Follow</h2>
          <ul class="site-footer__social" role="list">
            {socialLinks.map(([key, url]) => (
              <li>
                <a href={url} rel="me noopener noreferrer" target="_blank">
                  <SocialIcon network={key} />
                  {/* The icon is aria-hidden, so the accessible name lives here. */}
                  <span class="visually-hidden">
                    {labels[key] ?? key} (opens in a new tab)
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="container site-footer__legal">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    background: var(--brand-navy);
    color: #ffffff;
    padding-block: var(--space-2xl) var(--space-md);
  }

  .site-footer a {
    color: #cfe0f7;
  }

  .site-footer a:hover {
    color: #ffffff;
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
  }

  .site-footer__tagline {
    margin-block-start: var(--space-sm);
    color: #b4c4da;
    max-width: 32ch;
  }

  .site-footer .eyebrow {
    color: #94a8c4;
  }

  .site-footer__touch {
    text-align: center;
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-xs);
  }

  .site-footer__social a {
    /* 44px hit area around a 22px glyph -- the icon alone is well under the
       minimum comfortable target size. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.28);
  }

  .site-footer__social a:hover {
    color: var(--brand-navy);
    background: #ffffff;
    border-color: #ffffff;
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-xs);
    display: grid;
    gap: var(--space-2xs);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-size: var(--step--1);
    color: #b4c4da;
  }
</style>
