---
import { FORM_FIELDS } from '../../worker/brief-schema.js';

/**
 * A checkbox id from its label. The label is also the posted value, so the id
 * has to be derived rather than stored -- and it has to be stable, because the
 * <label for=…> beside it is the only thing making a pill clickable.
 * brief-schema.js has a test that no two choices collapse to the same slug.
 */
const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

/**
 * The problem solver at /build: tell us what keeps going wrong, we come back
 * to you.
 *
 * A plain form, and nothing else. No JavaScript at all -- it posts to
 * /api/intake like any form, and the Worker replies with a real confirmation
 * page. That means it works in every browser, cannot break in one, and has no
 * failure mode of its own beyond the send itself.
 *
 * There used to be an AI conversation here, offered on a "talk it through"
 * button. It is gone from this page, not from the product: worker/intake.js
 * still has the whole turn-by-turn path, still tested, and /api/intake still
 * serves it. Restoring the front end is a revert of the commit that removed
 * it. Nothing was thrown away.
 *
 * FORM_FIELDS comes from worker/brief-schema.js so these fields and the schema
 * the Worker structures them into cannot drift apart.
 */
---

<section class="solver" id="problem-solver" aria-labelledby="solver-heading">
  <h2 id="solver-heading" class="visually-hidden">Describe your problem</h2>

  <p class="solver__intro">
    Fill this in and we will take it from there. Every answer is optional
    except the first three — tell us what you can.
  </p>

  <form id="brief-form" method="POST" action="/api/intake">
    {FORM_FIELDS.map((f) => f.type === 'pills' ? (
      /* A group of checkboxes sharing one name, so it posts as a repeated key
         and needs no JavaScript. fieldset/legend rather than div/label because
         one label cannot name ninety-odd controls to a screen reader. */
      <fieldset class="field field--wide field--pills">
        <legend>
          {f.label}
          {!f.required && <span class="field__hint"> (optional)</span>}
          {f.hint && <span class="field__hint">{f.hint}</span>}
        </legend>

        {f.groups?.map((group, i) => (
          <div class="pills__group">
            <p class="pills__group-label" id={`pg-${f.name}-${i}`}>{group.label}</p>
            <ul class="pills" aria-labelledby={`pg-${f.name}-${i}`}>
              {group.options.map((option) => (
                <li>
                  <input
                    class="pill__input"
                    id={`bf-${f.name}-${slug(option)}`}
                    name={f.name}
                    type="checkbox"
                    value={option}
                  />
                  <label class="pill" for={`bf-${f.name}-${slug(option)}`}>{option}</label>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </fieldset>
    ) : (
      <div class={`field ${f.type === 'textarea' ? 'field--wide' : ''} ${f.type === 'checkbox' ? 'field--check field--wide' : ''}`}>
        {f.type === 'checkbox' ? (
          <>
            <input id={`bf-${f.name}`} name={f.name} type="checkbox" required={f.required} />
            <label for={`bf-${f.name}`}>{f.label}</label>
          </>
        ) : (
          <>
            <label for={`bf-${f.name}`}>
              {f.label}
              {!f.required && <span class="field__hint"> (optional)</span>}
              {f.hint && <span class="field__hint">{f.hint}</span>}
            </label>
            {f.type === 'textarea' ? (
              <textarea id={`bf-${f.name}`} name={f.name} rows={f.rows ?? 3} required={f.required} />
            ) : f.type === 'select' ? (
              <select id={`bf-${f.name}`} name={f.name} required={f.required}>
                {f.options?.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
            ) : (
              <input
                id={`bf-${f.name}`}
                name={f.name}
                type={f.type === 'email' ? 'email' : 'text'}
                required={f.required}
                autocomplete={f.autocomplete}
              />
            )}
          </>
        )}
      </div>
    ))}

    {/* Honeypot. Real people never see it, so anything filled in here is a bot
        and the Worker drops the request. */}
    <div class="form-trap" aria-hidden="true">
      <label for="bf-company-url">Do not fill this in</label>
      <input id="bf-company-url" name="companyUrl" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field--wide solver__actions">
      <button class="button" type="submit">Send</button>
    </div>
  </form>
</section>

<style>
  /* One centred column. The form is the page. */
  .solver {
    max-width: 46rem;
    margin-inline: auto;
  }

  .solver__intro {
    margin-block-end: var(--space-lg);
  }

  #brief-form {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    align-items: start;
  }

  .solver__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  /* ------------------------------------------------------------- the pills */

  /* .field is display:grid, and a fieldset's legend does not sit sensibly in a
     grid. Block layout, and the spacing set here rather than by the grid gap. */
  .field--pills {
    display: block;
    border: 0;
    margin: 0;
    padding: 0;
    /* Without this a fieldset refuses to shrink below its content, and the
       widest group of pills would push the whole form sideways. */
    min-inline-size: 0;
  }

  .field--pills > legend {
    padding: 0;
    margin-block-end: var(--space-xs);
    font-weight: 600;
    font-size: var(--step--1);
  }

  .pills__group + .pills__group {
    margin-block-start: var(--space-md);
  }

  .pills__group-label {
    margin: 0 0 var(--space-xs);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Off-screen rather than display:none, which would take the checkbox out of
     the tab order and leave the whole group unreachable by keyboard. The
     min-height is reset because .field input sets 44px for real inputs. */
  .pill__input {
    position: absolute;
    width: 1px;
    height: 1px;
    min-height: 0;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 44px tall to stay a comfortable touch target -- these are mostly tapped. */
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.9rem;
    font-weight: 400;
    font-size: var(--step--1);
    line-height: 1.3;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }

  .pill:hover {
    border-color: var(--color-accent);
  }

  /* The ring goes on the pill: the checkbox carrying focus is off-screen, so
     its own outline would be invisible. */
  .pill__input:focus-visible + .pill {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-color: var(--color-focus);
  }

  .pill__input:checked + .pill {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  /* Chosen must not rest on colour alone -- the tick reads without it. */
  .pill__input:checked + .pill::before {
    content: '\2713';
    margin-inline-end: 0.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .pill {
      transition: none;
    }
  }
</style>
