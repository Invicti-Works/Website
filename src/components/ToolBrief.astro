---
import { FORM_FIELDS } from '../../worker/brief-schema.js';

/**
 * The problem solver at /build: tell us what keeps going wrong, we come back
 * to you.
 *
 * A plain form, and nothing else. No JavaScript at all -- it posts to
 * /api/intake like any form, and the Worker replies with a real confirmation
 * page. That means it works in every browser, cannot break in one, and has no
 * failure mode of its own beyond the send itself.
 *
 * There used to be an AI conversation here, offered on a "talk it through"
 * button. It is gone from this page, not from the product: worker/intake.js
 * still has the whole turn-by-turn path, still tested, and /api/intake still
 * serves it. Restoring the front end is a revert of the commit that removed
 * it. Nothing was thrown away.
 *
 * FORM_FIELDS comes from worker/brief-schema.js so these fields and the schema
 * the Worker structures them into cannot drift apart.
 */
---

<section class="solver" id="problem-solver" aria-labelledby="solver-heading">
  <h2 id="solver-heading" class="visually-hidden">Describe your problem</h2>

  <p class="solver__intro">
    Fill this in and we will take it from there. Every answer is optional
    except the first three — tell us what you can.
  </p>

  <form id="brief-form" method="POST" action="/api/intake">
    {FORM_FIELDS.map((f) => (
      <div class={`field ${f.type === 'textarea' ? 'field--wide' : ''} ${f.type === 'checkbox' ? 'field--check field--wide' : ''}`}>
        {f.type === 'checkbox' ? (
          <>
            <input id={`bf-${f.name}`} name={f.name} type="checkbox" required={f.required} />
            <label for={`bf-${f.name}`}>{f.label}</label>
          </>
        ) : (
          <>
            <label for={`bf-${f.name}`}>
              {f.label}
              {!f.required && <span class="field__hint"> (optional)</span>}
              {f.hint && <span class="field__hint">{f.hint}</span>}
            </label>
            {f.type === 'textarea' ? (
              <textarea id={`bf-${f.name}`} name={f.name} rows={f.rows ?? 3} required={f.required} />
            ) : f.type === 'select' ? (
              <select id={`bf-${f.name}`} name={f.name} required={f.required}>
                {f.options?.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
            ) : (
              <input
                id={`bf-${f.name}`}
                name={f.name}
                type={f.type === 'email' ? 'email' : 'text'}
                required={f.required}
                autocomplete={f.autocomplete}
              />
            )}
          </>
        )}
      </div>
    ))}

    {/* Honeypot. Real people never see it, so anything filled in here is a bot
        and the Worker drops the request. */}
    <div class="form-trap" aria-hidden="true">
      <label for="bf-company-url">Do not fill this in</label>
      <input id="bf-company-url" name="companyUrl" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field--wide solver__actions">
      <button class="button" type="submit">Send</button>
    </div>
  </form>
</section>

<style>
  /* One centred column. The form is the page. */
  .solver {
    max-width: 46rem;
    margin-inline: auto;
  }

  .solver__intro {
    margin-block-end: var(--space-lg);
  }

  #brief-form {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    align-items: start;
  }

  .solver__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }
</style>
