---
import Logo from './Logo.astro';

// The header is the logo alone, by choice. Every destination is reachable from
// the page itself -- the hero has both calls to action -- and the footer
// carries the full list. Re-add a nav here if the site outgrows that.
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Invicti.Works — home">
      <Logo width={190} />
    </a>

  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-md);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
</style>
