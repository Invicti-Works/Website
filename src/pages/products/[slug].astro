---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
import {
  getProducts,
  CATEGORY_LABELS,
  PLATFORM_LABELS,
  STATUS_LABELS,
} from '../../lib/content';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { product } = Astro.props as Props;
const { Content } = await render(product);
const d = product.data;

const badgeClass =
  d.status === 'live' ? 'badge badge--live' : d.status === 'beta' ? 'badge badge--beta' : 'badge';

const externalLinks = [
  { href: d.links.demo, label: 'Try the demo' },
  { href: d.links.website, label: 'Visit the site' },
  { href: d.links.appStore, label: 'Download on the App Store' },
  { href: d.links.playStore, label: 'Get it on Google Play' },
].filter((link): link is { href: string; label: string } => Boolean(link.href));

// Structured data helps this page qualify for rich results in search.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: d.title,
  description: d.summary,
  applicationCategory: d.category === 'mobile' ? 'MobileApplication' : 'BusinessApplication',
  operatingSystem: d.platforms.map((p) => PLATFORM_LABELS[p]).join(', ') || undefined,
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  ...(d.pricing.length > 0
    ? {
        offers: d.pricing.map((tier) => ({
          '@type': 'Offer',
          name: tier.name,
          price: tier.price,
        })),
      }
    : {}),
};
---

<BaseLayout
  title={d.title}
  description={d.seo?.description ?? d.summary}
  image={d.image?.src}
  noindex={d.seo?.noindex}
>
  <section class="band product-hero">
    <div class="container product-hero__inner">
      <ul class="badge-row" role="list">
        <li><span class={badgeClass}>{STATUS_LABELS[d.status]}</span></li>
        <li><span class="badge">{CATEGORY_LABELS[d.category]}</span></li>
        {d.platforms.map((p) => (
          <li><span class="badge">{PLATFORM_LABELS[p]}</span></li>
        ))}
      </ul>
      <h1>{d.title}</h1>
      <p class="product-hero__tagline">{d.tagline}</p>
      <p class="product-hero__summary">{d.summary}</p>
      <div class="cta-row">
        <a class="button" href="/contact">{d.ctaLabel ?? 'Talk to us about ' + d.title}</a>
        {externalLinks.map((link) => (
          <a class="button button--secondary" href={link.href} rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {
    d.image && (
      <div class="container product-image">
        <img src={d.image.src} alt={d.image.alt} loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="container section">
    <div class="split">
      <div class="prose">
        <Content />
      </div>

      {
        d.features.length > 0 && (
          <div>
            <h2>What it does</h2>
            <ul class="checklist">
              {d.features.map((feature) => (
                <li>
                  <span class="feature-title">{feature.title}</span>
                  {feature.description && <span class="muted">{feature.description}</span>}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>

  {
    d.screenshots.length > 0 && (
      <section class="section section--subtle" aria-labelledby="screens-heading">
        <div class="container">
          <h2 id="screens-heading">Screenshots</h2>
          <ul class="grid screenshots" role="list">
            {d.screenshots.map((shot) => (
              <li>
                <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.pricing.length > 0 && (
      <section class="section" aria-labelledby="pricing-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="pricing-heading">Pricing</h2>
          </div>
          <ul class="grid" role="list">
            {d.pricing.map((tier) => (
              <li>
                <div class:list={['card', 'tier', tier.highlighted && 'tier--highlighted']}>
                  <h3>{tier.name}</h3>
                  <p class="tier__price">
                    {tier.price}
                    {tier.period && <span class="muted tier__period"> / {tier.period}</span>}
                  </p>
                  {tier.description && <p class="muted">{tier.description}</p>}
                  {tier.includes.length > 0 && (
                    <ul class="checklist tier__includes">
                      {tier.includes.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                  <p class="tier__cta">
                    <a class="button" href="/contact">
                      Get started
                      <span class="visually-hidden"> with the {tier.name} plan</span>
                    </a>
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.faq.length > 0 && (
      <section class="section section--subtle" aria-labelledby="faq-heading">
        <div class="container faq">
          <h2 id="faq-heading">Questions</h2>
          <dl>
            {d.faq.map((item) => (
              <>
                <dt>{item.question}</dt>
                <dd>{item.answer}</dd>
              </>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  <div class="container back">
    <a href="/products">&larr; All products</a>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</BaseLayout>

<style>
  .product-hero {
    padding-block: var(--space-2xl);
  }

  .product-hero__inner {
    max-width: 46rem;
  }

  .product-hero h1 {
    margin-block-start: var(--space-sm);
  }

  .product-hero__tagline {
    margin-block-start: var(--space-sm);
    font-size: var(--step-1);
    font-weight: 600;
    color: #ffc79a;
  }

  .product-hero__summary {
    margin-block-start: var(--space-md);
    color: #cfe0f7;
  }

  .product-image {
    margin-block-start: var(--space-xl);
  }

  .product-image img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .grid {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-lg);
  }

  .screenshots img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .tier {
    gap: var(--space-sm);
  }

  .tier--highlighted {
    border-color: var(--color-accent);
    border-width: 2px;
  }

  .tier__price {
    font-size: var(--step-2);
    font-weight: 800;
  }

  .tier__period {
    font-size: var(--step-0);
    font-weight: 400;
  }

  .tier__includes {
    margin-block-start: var(--space-xs);
  }

  .tier__cta {
    margin-block-start: auto;
    padding-block-start: var(--space-md);
  }

  .faq {
    max-width: var(--measure);
  }

  .faq dt {
    font-weight: 700;
    margin-block-start: var(--space-lg);
  }

  .faq dd {
    margin: var(--space-2xs) 0 0;
    color: var(--color-text-muted);
  }

  .back {
    padding-block: var(--space-xl);
    font-weight: 600;
  }
</style>
