---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SolutionFinder from '../components/SolutionFinder.astro';
import site from '../data/site.json';
import { getTeam } from '../lib/content';

const team = await getTeam();
const bios = await Promise.all(
  team.map(async (member) => ({ member, Content: (await render(member)).Content })),
);
---

<BaseLayout title="Home">
  <section class="band hero">
    <div class="container hero__inner">
      <p class="eyebrow">Mobile and web applications</p>
      <h1>{site.tagline}</h1>
      <p class="hero__lede">{site.description}</p>
      <div class="cta-row">
        <a class="button" href="#find-your-solution">Find your solution</a>
        <a class="button button--secondary" href="/contact">Contact Us</a>
      </div>
    </div>
  </section>

  {
    bios.length > 0 && (
      <section class="section" aria-labelledby="founders-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="founders-heading">Who we are</h2>
          </div>
          <div class="team">
            {bios.map(({ member, Content }) => (
              <article class="team__member">
                {member.data.image && (
                  /* alt="" on purpose: the name sits right beside it, so
                     describing the photo would just repeat that name. */
                  <img
                    class="team__photo"
                    src={member.data.image}
                    alt=""
                    width="120"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <h3>{member.data.name}</h3>
                <p class="team__role">{member.data.role}</p>
                <p class="muted team__summary">{member.data.summary}</p>
                <div class="prose team__bio">
                  <Content />
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <SolutionFinder />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-2xl);
  }

  .hero__inner {
    max-width: 46rem;
  }

  .hero h1 {
    margin-block-start: var(--space-sm);
  }

  .hero__lede {
    margin-block-start: var(--space-md);
    font-size: var(--step-1);
    color: #cfe0f7;
  }

  .team {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
  }

  .team__member {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-subtle);
  }

  .team__photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-block-end: var(--space-md);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .team__member h3 {
    font-size: var(--step-2);
  }

  .team__role {
    font-weight: 600;
    color: var(--color-accent-warm);
    margin-block-start: var(--space-2xs);
  }

  .team__summary {
    margin-block-start: var(--space-sm);
  }

  .team__bio {
    margin-block-start: var(--space-md);
  }

</style>
