---
import PageLayout from '../layouts/PageLayout.astro';
import site from '../data/site.json';
---

<PageLayout
  title="Contact"
  summary="Tell us what you are trying to build, and we will come back to you."
>
  <div class="prose">
    <p>
      Email is the fastest way to reach us. A sentence or two about what you have
      in mind is enough — we will come back with an honest read on scope and
      approach.
    </p>

    <p class="contact__cta">
      <a class="button" href={`mailto:${site.email}?subject=${encodeURIComponent('Getting in touch')}`}>
        Email {site.email}
      </a>
    </p>

    {/*
      NOTE: this is a fully static site, so there is no server to accept a form
      post. A real contact form needs a decision first -- see docs/SETUP.md,
      "Contact and lead-capture forms". Until then this mailto always works and
      cannot silently drop a lead.
    */}
  </div>
</PageLayout>

<style>
  .contact__cta {
    margin-block-start: var(--space-lg);
  }
</style>
