---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { getNews, formatDate } from '../../lib/content';

export const getStaticPaths = (async () => {
  const posts = await getNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;
const { Content } = await render(post);
---

<PageLayout
  title={post.data.title}
  summary={post.data.summary}
  description={post.data.seo?.description}
  image={post.data.image?.src}
  type="article"
  publishedTime={post.data.date}
  noindex={post.data.seo?.noindex}
>
  <p slot="meta" class="post__meta muted">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    {post.data.author && <> &middot; {post.data.author}</>}
  </p>

  {
    post.data.image && (
      <img
        class="post__image"
        src={post.data.image.src}
        alt={post.data.image.alt}
        loading="lazy"
        decoding="async"
      />
    )
  }

  <article class="prose">
    <Content />
  </article>

  <p class="back">
    <a href="/news">&larr; All news</a>
  </p>
</PageLayout>

<style>
  .post__meta {
    margin-block-start: var(--space-md);
    font-size: var(--step--1);
  }

  .post__image {
    width: 100%;
    max-width: var(--measure);
    border-radius: var(--radius);
    margin-block-end: var(--space-lg);
  }

  .back {
    margin-block-start: var(--space-xl);
    font-weight: 600;
  }
</style>
