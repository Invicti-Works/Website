---
import PageLayout from '../../layouts/PageLayout.astro';

/**
 * /console — the founders' dashboard.
 *
 * A static shell that fetches from /api/console/briefs on load. The page holds
 * no data at build time, which is what makes it safe to serve from the same
 * public asset layer as everything else: without a valid Cloudflare Access
 * assertion the API answers 403 and this renders an empty state.
 *
 * Cloudflare Access gates /console* and /api/console* at the edge, and
 * worker/lib/access.js re-checks the assertion on every API call. Two
 * independent gates on purpose — see the note at the top of that file.
 *
 * noindex, and excluded from the sitemap in astro.config.mjs and from
 * robots.txt. Not a security measure, just tidiness: Access already stops a
 * crawler getting this far.
 */
---

<PageLayout
  title="Console"
  summary="Briefs from the problem solver, and what has been done with them."
  noindex
>
  <div class="console-toolbar">
    <div class="console-counts" id="counts" aria-live="polite"></div>
    <div class="field console-filter">
      <label for="state-filter">Show</label>
      <select id="state-filter">
        <option value="">Everything</option>
        <option value="new">New</option>
        <option value="queued">Queued</option>
        <option value="building">Building</option>
        <option value="review">In review</option>
        <option value="published">Published</option>
        <option value="declined">Declined</option>
      </select>
    </div>
  </div>

  <p class="form-status" id="status" role="status" aria-live="polite">Loading briefs…</p>

  <div class="console-table-wrap">
    <table class="console-table" id="table" hidden>
      <caption class="visually-hidden">Build briefs, newest first</caption>
      <thead>
        <tr>
          <th scope="col">Problem</th>
          <th scope="col">From</th>
          <th scope="col">Complete</th>
          <th scope="col">Size</th>
          <th scope="col">State</th>
          <th scope="col">Captured</th>
        </tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
</PageLayout>

<script is:inline>
  (() => {
    const status = document.getElementById('status');
    const table = document.getElementById('table');
    const rows = document.getElementById('rows');
    const counts = document.getElementById('counts');
    const filter = document.getElementById('state-filter');

    const setStatus = (text, kind) => {
      status.textContent = text;
      if (kind) status.dataset.kind = kind;
      else delete status.dataset.kind;
    };

    const day = (ms) =>
      new Date(ms).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

    let all = [];

    const render = () => {
      const want = filter.value;
      const shown = want ? all.filter((b) => (b.build_state ?? 'new') === want) : all;

      rows.replaceChildren(
        ...shown.map((b) => {
          const tr = document.createElement('tr');

          const th = document.createElement('th');
          th.scope = 'row';
          const link = document.createElement('a');
          link.href = `/console/brief/?id=${encodeURIComponent(b.id)}`;
          link.textContent = b.headline || '(no headline captured)';
          th.append(link);

          const cell = (text, className) => {
            const td = document.createElement('td');
            td.textContent = text ?? '—';
            if (className) td.className = className;
            return td;
          };

          const state = document.createElement('td');
          const badge = document.createElement('span');
          badge.className = 'state';
          badge.dataset.state = b.build_state ?? 'new';
          badge.textContent = b.build_state ?? 'new';
          state.append(badge);

          tr.append(
            th,
            cell([b.name, b.organization].filter(Boolean).join(' · ')),
            cell(`${b.completeness ?? 0}%`),
            cell(b.complexity),
            state,
            cell(day(b.created_at)),
          );
          return tr;
        }),
      );

      table.hidden = shown.length === 0;
      if (shown.length === 0) {
        setStatus(all.length ? 'Nothing in that state.' : 'No briefs yet.', null);
      } else {
        setStatus(`${shown.length} brief${shown.length === 1 ? '' : 's'}.`, null);
      }
    };

    filter.addEventListener('change', render);

    (async () => {
      try {
        const response = await fetch('/api/console/briefs', { headers: { accept: 'application/json' } });

        if (response.status === 403) {
          setStatus(
            'Not signed in, or Cloudflare Access is not set up for this path yet. See docs/SETUP.md step 13.',
            'error',
          );
          return;
        }
        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          setStatus(payload.error ?? `Could not load briefs (${response.status}).`, 'error');
          return;
        }

        const payload = await response.json();
        all = payload.briefs ?? [];
        counts.textContent = Object.entries(payload.counts ?? {})
          .map(([state, n]) => `${n} ${state}`)
          .join(' · ');
        render();
      } catch {
        setStatus('Could not reach the console API.', 'error');
      }
    })();
  })();
</script>

<style>
  .console-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-lg);
  }

  .console-counts {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .console-filter {
    min-width: 12rem;
  }

  /* Six columns will not fit a phone, so let the table scroll inside its own
     box rather than making the whole page scroll sideways. */
  .console-table-wrap {
    overflow-x: auto;
  }

  .console-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .console-table :is(th, td) {
    text-align: start;
    padding: var(--space-sm);
    border-block-end: 1px solid var(--color-border);
    vertical-align: top;
  }

  .console-table thead th {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .console-table tbody th {
    font-weight: 600;
    max-width: 28rem;
  }

  .state {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    font-size: var(--step--1);
    text-transform: capitalize;
  }

  .state[data-state='new'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Warm, not brand orange: #f87000 is 2.87:1 on white. docs/BRAND.md. */
  .state[data-state='declined'] {
    color: var(--color-text-muted);
  }

  .state[data-state='queued'],
  .state[data-state='building'] {
    border-color: var(--color-accent-warm);
    color: var(--color-accent-warm);
  }
</style>
