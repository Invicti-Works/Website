---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { getPages } from '../lib/content';

/**
 * Generates standalone content pages (privacy, terms, ...) from the `pages`
 * collection, so a new page can be added in the CMS without code.
 *
 * Slugs that already have a hand-built route are skipped: Astro would resolve
 * the file-based route anyway and warn about the collision on every build.
 * `about` is the case today -- src/pages/about.astro renders that entry plus
 * the founder list.
 */
export const getStaticPaths = (async () => {
  // Declared inside the function on purpose: Astro extracts getStaticPaths
  // into its own module scope, so a const in the component frontmatter is
  // not visible here and would throw at build time.
  const routesWithDedicatedPages = new Set(['about', 'contact', 'news', 'products', '404']);

  const pages = await getPages();
  return pages
    .filter((page) => !routesWithDedicatedPages.has(page.id))
    .map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { Content } = await render(page);
---

<PageLayout
  title={page.data.title}
  summary={page.data.summary}
  description={page.data.seo?.description}
  noindex={page.data.seo?.noindex}
>
  <article class="prose">
    <Content />
  </article>
</PageLayout>
