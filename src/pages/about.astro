---
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { getPages, getTeam } from '../lib/content';

// The narrative half of this page is CMS-editable like any other page; the
// founder list below is its own collection so people can be added or
// reordered without touching the page copy.
const pages = await getPages();
const about = pages.find((page) => page.id === 'about');
const Body = about ? (await render(about)).Content : null;

const team = await getTeam();
const bios = await Promise.all(
  team.map(async (member) => ({ member, Content: (await render(member)).Content })),
);
---

<PageLayout
  title={about?.data.title ?? 'About'}
  summary={about?.data.summary ?? 'Who we are and what we build.'}
>
  {Body && (
    <article class="prose">
      <Body />
    </article>
  )}

  {
    bios.length > 0 && (
      <section class="team" aria-labelledby="team-heading">
        <h2 id="team-heading">Founders</h2>
        <div class="team__list">
          {bios.map(({ member, Content }) => (
            <article class="team__member">
              {member.data.image && (
                /* alt="" on purpose: the name sits right beside it, so
                   describing the photo would just repeat that name. */
                <img
                  class="team__photo"
                  src={member.data.image}
                  alt=""
                  width="120"
                  height="120"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <h3>{member.data.name}</h3>
              <p class="team__role">{member.data.role}</p>
              <p class="muted team__summary">{member.data.summary}</p>
              <div class="prose team__bio">
                <Content />
              </div>
              {(member.data.links.linkedin || member.data.links.github || member.data.links.email) && (
                <ul class="team__links" role="list">
                  {member.data.links.linkedin && (
                    <li>
                      <a href={member.data.links.linkedin} rel="noopener noreferrer">
                        LinkedIn
                        <span class="visually-hidden"> profile for {member.data.name}</span>
                      </a>
                    </li>
                  )}
                  {member.data.links.github && (
                    <li>
                      <a href={member.data.links.github} rel="noopener noreferrer">
                        GitHub
                        <span class="visually-hidden"> profile for {member.data.name}</span>
                      </a>
                    </li>
                  )}
                  {member.data.links.email && (
                    <li>
                      <a href={`mailto:${member.data.links.email}`}>{member.data.links.email}</a>
                    </li>
                  )}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>
    )
  }
</PageLayout>

<style>
  .team {
    margin-block-start: var(--space-2xl);
  }

  .team__list {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
  }

  .team__member {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-subtle);
  }

  .team__photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-block-end: var(--space-md);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .team__member h3 {
    font-size: var(--step-2);
  }

  .team__role {
    font-weight: 600;
    color: var(--color-accent-warm);
    margin-block-start: var(--space-2xs);
  }

  .team__summary {
    margin-block-start: var(--space-sm);
  }

  .team__bio {
    margin-block-start: var(--space-md);
  }

  .team__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-md);
    font-weight: 600;
  }
</style>
