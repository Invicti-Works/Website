---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const { title, description, image, type, publishedTime, noindex } = Astro.props;
const lang = site.locale.split('_')[0] ?? 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The .ico carries 16, 32 and 48px frames; declaring only one of them
        made browsers that pick by size skip it. Modern browsers take the PNG,
        older ones fall back to the .ico. Both are cut from the logo mark by
        scripts/derive-brand-assets.py. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#003870" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
    />
  </head>
  <body>
    <!-- First focusable element on the page, per WCAG 2.4.1 Bypass Blocks. -->
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
